generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id                       String                    @id @default(cuid())
  name                     String
  legalForm                String
  ice                      String
  taxId                    String
  city                     String
  baseCurrency             String                    @default("MAD")
  vatFrequency             String                    @default("MONTHLY")
  fiscalYears              FiscalYear[]
  accounts                 Account[]
  journals                 Journal[]
  entries                  Entry[]
  invoices                 Invoice[]
  documents                Document[]
  bankAccounts             BankAccount[]
  employees                Employee[]
  taxPeriods               TaxPeriod[]
  activityLogs             ActivityLog[]
  companyUsers             CompanyUser[]
  payrollRuns              PayrollRun[]
  counterparties           Counterparty[]
  invoiceSequences         InvoiceSequence[]
  payments                 Payment[]
  bankReconciliations      BankReconciliation[]
  ledgerImportBatches      LedgerImportBatch[]
  bankImportProfiles       BankImportProfile[]
  auditChain               AuditChain?
  invoiceArtifacts         InvoiceArtifact[]
  taxConfigurationVersions TaxConfigurationVersion[]
  vatWorkpapers            VatWorkpaper[]
  fiscalCloseRuns          FiscalCloseRun[]
  journalPieceSequences    JournalPieceSequence[]
  openingBalanceRuns       OpeningBalanceRun[]
  fiscalPackages           FiscalPackage[]
  reportConfigurations     ReportConfiguration[]
  wheatAiSettings          WheatAiSettings?
  wheatAiAuditEvents       WheatAiAuditEvent[]
  wheatKnowledgePatterns   WheatKnowledgePattern[]
  sageExportProfile        SageExportProfile?
  guidedStepDecisions      GuidedStepDecision[]
  formDrafts               FormDraft[]
  version                  Int                       @default(1)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([name])
}

model FiscalYear {
  id               String                 @id @default(cuid())
  companyId        String
  label            String
  startsOn         DateTime
  endsOn           DateTime
  lockedTo         DateTime?
  status           String                 @default("OPEN")
  closedAt         DateTime?
  closedByUserId   String?
  closeRunId       String?                @unique
  reopenedAt       DateTime?
  reopenedByUserId String?
  reopenReason     String?
  version          Int                    @default(1)
  company          Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  closedBy         User?                  @relation("FiscalYearClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  reopenedBy       User?                  @relation("FiscalYearReopenedBy", fields: [reopenedByUserId], references: [id], onDelete: SetNull)
  closeRun         FiscalCloseRun?        @relation("FiscalYearActiveClose", fields: [closeRunId], references: [id], onDelete: SetNull)
  closeRuns        FiscalCloseRun[]       @relation("FiscalYearCloseRuns")
  pieceSequences   JournalPieceSequence[]
  openingRuns      OpeningBalanceRun[]
  fiscalPackages   FiscalPackage[]

  @@index([companyId, startsOn, endsOn])
}

model User {
  id                    String                    @id @default(cuid())
  name                  String
  email                 String                    @unique
  role                  String
  twoFactorOn           Boolean                   @default(false)
  companyUsers          CompanyUser[]
  activityLogs          ActivityLog[]
  ledgerImportBatches   LedgerImportBatch[]       @relation("LedgerImportActor")
  auditEvents           AuditEvent[]              @relation("AuditEventActor")
  auditSeals            AuditSeal[]               @relation("AuditSealActor")
  fiscalYearsClosed     FiscalYear[]              @relation("FiscalYearClosedBy")
  fiscalYearsReopened   FiscalYear[]              @relation("FiscalYearReopenedBy")
  invoiceArtifacts      InvoiceArtifact[]         @relation("InvoiceArtifactActor")
  taxConfigurations     TaxConfigurationVersion[] @relation("TaxConfigurationActor")
  vatWorkpapersReviewed VatWorkpaper[]            @relation("VatWorkpaperReviewer")
  vatWorkpapersFiled    VatWorkpaper[]            @relation("VatWorkpaperFiler")
  fiscalCloseRuns       FiscalCloseRun[]          @relation("FiscalCloseActor")
  fiscalTablesReviewed  FiscalTableWorkpaper[]    @relation("FiscalTableReviewer")
}

model CompanyUser {
  id        String  @id @default(cuid())
  companyId String
  userId    String
  role      String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
}

model SageExportProfile {
  id                    String   @id @default(cuid())
  companyId             String   @unique
  profileType           String
  outputKind            String
  encoding              String
  includeHeader         Boolean  @default(false)
  accountLength         String   @default("VARIABLE")
  journalMappings       String   @default("{}")
  accountMappings       String   @default("{}")
  thirdPartyMappings    String   @default("{}")
  requireJournalMapping Boolean  @default(true)
  version               Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Account {
  id                       String               @id @default(cuid())
  companyId                String
  code                     String
  label                    String
  labelArabic              String?
  parentCode               String?
  classNo                  Int
  type                     String
  hierarchyDepth           Int                  @default(0)
  isStandard               Boolean              @default(false)
  active                   Boolean              @default(true)
  category                 String               @default("CUSTOM")
  reportNature             String?
  auxiliaryEligible        Boolean              @default(false)
  expectedBalance          String               @default("VARIABLE")
  reportingMappingsJson    String               @default("{}")
  fiscalMappingsJson       String               @default("{}")
  effectiveFrom            DateTime?
  effectiveTo              DateTime?
  standardVersion          String?
  postable                 Boolean              @default(true)
  searchText               String               @default("")
  version                  Int                  @default(1)
  company                  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines                    EntryLine[]
  bankAccounts             BankAccount[]        @relation("BankLedgerAccount")
  receivableCounterparties Counterparty[]       @relation("CounterpartyReceivable")
  payableCounterparties    Counterparty[]       @relation("CounterpartyPayable")
  controlledInvoices       Invoice[]            @relation("InvoiceControl")
  vatInvoices              Invoice[]            @relation("InvoiceVat")
  invoiceLines             InvoiceLine[]
  controlledPayments       Payment[]            @relation("PaymentControl")
  settledPayments          Payment[]            @relation("PaymentSettlement")
  taxRateDefinitions       TaxRateDefinition[]
  openingBalanceLines      OpeningBalanceLine[]

  @@unique([companyId, code])
  @@index([companyId, active, classNo])
  @@index([companyId, parentCode, active])
  @@index([companyId, isStandard, postable])
}

model Journal {
  id                       String                 @id @default(cuid())
  companyId                String
  code                     String
  label                    String
  nextNumber               Int                    @default(1)
  piecePrefix              String?
  piecePattern             String                 @default("{journal}-{year}-{sequence}")
  pieceYearFormat          String                 @default("YYYY")
  piecePadding             Int                    @default(6)
  pieceSeparator           String                 @default("-")
  allowManualPieceOverride Boolean                @default(false)
  locked                   Boolean                @default(false)
  active                   Boolean                @default(true)
  version                  Int                    @default(1)
  company                  Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries                  Entry[]
  pieceSequences           JournalPieceSequence[]

  @@unique([companyId, code])
  @@index([companyId, active])
}

model Entry {
  id                  String            @id @default(cuid())
  companyId           String
  journalId           String
  number              String
  date                DateTime
  pieceNumber         String
  pieceNumberRaw      String?
  pieceNumberSearch   String?
  pieceSequenceNo     Int?
  pieceFiscalYearId   String?
  label               String
  status              String            @default("DRAFT")
  source              String            @default("MANUAL")
  auditNote           String?
  postedAt            DateTime?
  reversedAt          DateTime?
  reversalOfId        String?
  journalCodeSnapshot String
  version             Int               @default(1)
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journal             Journal           @relation(fields: [journalId], references: [id])
  reversalOf          Entry?            @relation("EntryReversals", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals           Entry[]           @relation("EntryReversals")
  postedPayrollRun    PayrollRun?       @relation("PayrollRunPosting")
  voidedPayrollRun    PayrollRun?       @relation("PayrollRunVoid")
  lines               EntryLine[]
  documents           Document[]
  postedInvoice       Invoice?          @relation("InvoicePosting")
  voidedInvoice       Invoice?          @relation("InvoiceVoid")
  postedPayment       Payment?          @relation("PaymentPosting")
  voidedPayment       Payment?          @relation("PaymentVoid")
  ledgerImportRows    LedgerImportRow[] @relation("LedgerImportDraft")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([companyId, number])
  @@index([companyId, date, status])
  @@index([journalId, date])
  @@index([companyId, journalId, pieceNumber])
  @@index([reversalOfId])
}

model JournalPieceSequence {
  id           String     @id @default(cuid())
  companyId    String
  journalId    String
  fiscalYearId String
  nextNumber   Int        @default(1)
  lastIssued   Int        @default(0)
  version      Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journal      Journal    @relation(fields: [journalId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@unique([journalId, fiscalYearId])
  @@index([companyId, fiscalYearId])
}

model EntryLine {
  id                            String                         @id @default(cuid())
  entryId                       String
  accountId                     String
  label                         String
  debitCents                    BigInt                         @default(0)
  creditCents                   BigInt                         @default(0)
  thirdParty                    String?
  counterpartyId                String?
  position                      Int
  accountCodeSnapshot           String
  accountLabelSnapshot          String
  entry                         Entry                          @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account                       Account                        @relation(fields: [accountId], references: [id])
  counterparty                  Counterparty?                  @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  bankReconciliationAllocations BankReconciliationAllocation[]

  @@unique([entryId, position])
  @@index([counterpartyId])
  @@index([accountId, entryId])
}

model Counterparty {
  id                         String   @id @default(cuid())
  companyId                  String
  kind                       String
  displayName                String
  legalName                  String?
  ice                        String?
  taxId                      String?
  email                      String?
  phone                      String?
  address                    String?
  city                       String?
  identityKey                String
  defaultReceivableAccountId String?
  defaultPayableAccountId    String?
  paymentTermsDays           Int      @default(30)
  active                     Boolean  @default(true)
  version                    Int      @default(1)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  company                  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultReceivableAccount Account?    @relation("CounterpartyReceivable", fields: [defaultReceivableAccountId], references: [id], onDelete: SetNull)
  defaultPayableAccount    Account?    @relation("CounterpartyPayable", fields: [defaultPayableAccountId], references: [id], onDelete: SetNull)
  invoices                 Invoice[]
  payments                 Payment[]
  entryLines               EntryLine[]

  @@unique([companyId, identityKey])
  @@index([companyId, displayName])
  @@index([companyId, kind, active])
}

model InvoiceSequence {
  id         String  @id @default(cuid())
  companyId  String
  series     String  @default("FA")
  year       Int
  nextNumber Int     @default(1)
  padding    Int     @default(6)
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, series, year])
}

model Invoice {
  id                        String                   @id @default(cuid())
  companyId                 String
  kind                      String
  counterparty              String
  ice                       String?
  invoiceNo                 String
  invoiceDate               DateTime
  dueDate                   DateTime?
  paymentDate               DateTime?
  htCents                   BigInt
  vatCents                  BigInt
  ttcCents                  BigInt
  status                    String
  paymentMethod             String?
  counterpartyId            String?
  numberKey                 String?
  series                    String?
  sequenceYear              Int?
  sequenceNo                Int?
  currency                  String                   @default("MAD")
  counterpartyNameSnapshot  String?
  iceSnapshot               String?
  taxIdSnapshot             String?
  billingAddressSnapshot    String?
  lifecycleStatus           String                   @default("LEGACY")
  legacyStatus              String?
  source                    String                   @default("LEGACY_1_1")
  notes                     String?
  needsReview               Boolean                  @default(true)
  reviewNote                String?
  documentType              String                   @default("INVOICE")
  creditedInvoiceId         String?
  creditReason              String?
  taxConfigurationVersionId String?
  artifactRequired          Boolean                  @default(false)
  controlAccountId          String?
  vatAccountId              String?
  postedEntryId             String?                  @unique
  voidEntryId               String?                  @unique
  postedAt                  DateTime?
  voidedAt                  DateTime?
  voidReason                String?
  version                   Int                      @default(1)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  company                   Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  counterpartyModel         Counterparty?            @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  controlAccount            Account?                 @relation("InvoiceControl", fields: [controlAccountId], references: [id], onDelete: Restrict)
  vatAccount                Account?                 @relation("InvoiceVat", fields: [vatAccountId], references: [id], onDelete: Restrict)
  postedEntry               Entry?                   @relation("InvoicePosting", fields: [postedEntryId], references: [id], onDelete: Restrict)
  voidEntry                 Entry?                   @relation("InvoiceVoid", fields: [voidEntryId], references: [id], onDelete: Restrict)
  creditedInvoice           Invoice?                 @relation("InvoiceCreditNotes", fields: [creditedInvoiceId], references: [id], onDelete: Restrict)
  creditNotes               Invoice[]                @relation("InvoiceCreditNotes")
  taxConfigurationVersion   TaxConfigurationVersion? @relation(fields: [taxConfigurationVersionId], references: [id], onDelete: Restrict)
  lines                     InvoiceLine[]
  allocations               PaymentAllocation[]
  documents                 Document[]
  artifacts                 InvoiceArtifact[]
  vatWorkpaperLines         VatWorkpaperLine[]

  @@unique([companyId, numberKey])
  @@index([companyId, kind, invoiceDate])
  @@index([companyId, lifecycleStatus, dueDate])
  @@index([counterpartyId, dueDate])
  @@index([creditedInvoiceId, documentType])
  @@index([taxConfigurationVersionId])
}

model InvoiceLine {
  id                               String  @id @default(cuid())
  invoiceId                        String
  position                         Int
  description                      String
  accountId                        String?
  quantityMilli                    BigInt?
  unitPriceCents                   BigInt?
  discountCents                    BigInt  @default(0)
  vatRateBps                       Int?
  creditedInvoiceLineId            String?
  taxRateDefinitionId              String?
  taxRateCodeSnapshot              String?
  taxRateLabelSnapshot             String?
  taxRateDirectionSnapshot         String?
  taxConfigurationRevisionSnapshot Int?
  htCents                          BigInt  @default(0)
  vatCents                         BigInt  @default(0)
  ttcCents                         BigInt  @default(0)
  isLegacySummary                  Boolean @default(false)

  invoice             Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account             Account?           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  creditedInvoiceLine InvoiceLine?       @relation("InvoiceLineCredits", fields: [creditedInvoiceLineId], references: [id], onDelete: Restrict)
  creditNoteLines     InvoiceLine[]      @relation("InvoiceLineCredits")
  taxRateDefinition   TaxRateDefinition? @relation(fields: [taxRateDefinitionId], references: [id], onDelete: Restrict)
  vatWorkpaperLines   VatWorkpaperLine[]

  @@unique([invoiceId, position])
  @@index([accountId])
  @@index([creditedInvoiceLineId])
  @@index([taxRateDefinitionId])
}

model Payment {
  id                  String    @id @default(cuid())
  companyId           String
  counterpartyId      String
  kind                String
  paymentDate         DateTime
  reference           String?
  method              String
  currency            String    @default("MAD")
  amountCents         BigInt    @default(0)
  lifecycleStatus     String    @default("DRAFT")
  source              String    @default("MANUAL")
  notes               String?
  controlAccountId    String?
  settlementAccountId String?
  bankAccountId       String?
  postedEntryId       String?   @unique
  voidEntryId         String?   @unique
  postedAt            DateTime?
  voidedAt            DateTime?
  voidReason          String?
  version             Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company           Company                             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  counterparty      Counterparty                        @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  controlAccount    Account?                            @relation("PaymentControl", fields: [controlAccountId], references: [id], onDelete: Restrict)
  settlementAccount Account?                            @relation("PaymentSettlement", fields: [settlementAccountId], references: [id], onDelete: Restrict)
  bankAccount       BankAccount?                        @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  postedEntry       Entry?                              @relation("PaymentPosting", fields: [postedEntryId], references: [id], onDelete: Restrict)
  voidEntry         Entry?                              @relation("PaymentVoid", fields: [voidEntryId], references: [id], onDelete: Restrict)
  allocations       PaymentAllocation[]
  bankEvidence      BankReconciliationPaymentEvidence[]
  documents         Document[]

  @@index([companyId, lifecycleStatus, paymentDate])
  @@index([counterpartyId, paymentDate])
}

model PaymentAllocation {
  id                     String    @id @default(cuid())
  paymentId              String
  invoiceId              String
  amountCents            BigInt
  status                 String    @default("ACTIVE")
  createdAt              DateTime  @default(now())
  reversedAt             DateTime?
  reversalReason         String?
  reversalAccountingDate DateTime?

  payment           Payment            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice           Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  vatWorkpaperLines VatWorkpaperLine[]

  @@index([paymentId, status])
  @@index([invoiceId, status])
}

model Document {
  id                    String                   @id @default(cuid())
  companyId             String
  entryId               String?
  invoiceId             String?
  paymentId             String?
  title                 String
  type                  String
  fiscalYear            String
  tags                  String
  storedPath            String?
  contentSha256         String?
  mimeType              String?
  byteSize              BigInt?
  ocrText               String
  extracted             String
  status                String                   @default("TO_REVIEW")
  company               Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entry                 Entry?                   @relation(fields: [entryId], references: [id])
  invoice               Invoice?                 @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment               Payment?                 @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  vatFilingReceipts     VatWorkpaper[]           @relation("VatFilingReceipt")
  vatWorkpaperEvidence  VatWorkpaperEvidence[]
  vatAdjustmentEvidence VatWorkpaperAdjustment[]
  fiscalTableEvidence   FiscalTableEvidence[]
  createdAt             DateTime                 @default(now())

  @@index([companyId, status, createdAt])
  @@index([companyId, contentSha256])
}

model BankAccount {
  id              String                @id @default(cuid())
  companyId       String
  bankName        String
  iban            String
  balanceCents    BigInt
  currency        String                @default("MAD")
  ledgerAccountId String?               @unique
  balanceAsOf     DateTime?
  balanceSource   String                @default("LEGACY_ESTIMATE")
  active          Boolean               @default(true)
  version         Int                   @default(1)
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledgerAccount   Account?              @relation("BankLedgerAccount", fields: [ledgerAccountId], references: [id], onDelete: SetNull)
  movements       BankMovement[]
  statements      BankStatementImport[]
  payments        Payment[]
  importProfiles  BankImportProfile[]

  @@index([companyId, active])
}

model BankStatementImport {
  id                     String    @id @default(cuid())
  bankAccountId          String
  sourceName             String
  sourceStoredPath       String?
  sourceSha256           String
  startsOn               DateTime?
  endsOn                 DateTime?
  openingBalanceCents    BigInt?
  closingBalanceCents    BigInt?
  rowCount               Int
  sourceFormat           String    @default("UNKNOWN")
  importedCount          Int       @default(0)
  skippedCount           Int       @default(0)
  errorCount             Int       @default(0)
  duplicateCount         Int       @default(0)
  // Frozen column default: SQLite cannot alter a default without rebuilding the
  // table, and every write sets this explicitly to the current marker. Readers
  // accept both spellings via legacyDomainValues.STORED_SCHEMA_VERSIONS.
  canonicalSchemaVersion String    @default("ATLAS_BANK_1")
  validationJson         String    @default("{}")
  status                 String    @default("ACTIVE")
  importedAt             DateTime  @default(now())
  voidedAt               DateTime?
  voidReason             String?

  bankAccount BankAccount    @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  movements   BankMovement[]

  @@unique([bankAccountId, sourceSha256])
  @@index([bankAccountId, endsOn])
}

model BankMovement {
  id                 String               @id @default(cuid())
  bankAccountId      String
  date               DateTime
  label              String
  amountCents        BigInt
  reference          String
  status             String
  confidence         Int
  statementId        String?
  statementRow       Int?
  valueDate          DateTime?
  operationDateRaw   String?
  valueDateRaw       String?
  dateInferred       Boolean              @default(false)
  rowClass           String               @default("TRANSACTION")
  sourcePage         Int?
  rawJson            String               @default("{}")
  confidenceJson     String               @default("{}")
  externalId         String?
  fingerprint        String?
  legacyMatchClaimed Boolean              @default(false)
  legacyConfidence   Int?
  revision           Int                  @default(0)
  excludedAt         DateTime?
  exclusionReason    String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  bankAccount        BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  statement          BankStatementImport? @relation(fields: [statementId], references: [id], onDelete: Restrict)
  reconciliations    BankReconciliation[]

  @@unique([statementId, statementRow])
  @@index([bankAccountId, date])
  @@index([statementId, date])
  @@index([bankAccountId, fingerprint])
}

model BankReconciliation {
  id                String    @id @default(cuid())
  companyId         String
  bankMovementId    String
  status            String    @default("ACTIVE")
  note              String?
  movementSnapshot  String
  confirmedAt       DateTime  @default(now())
  confirmedByUserId String?
  voidedAt          DateTime?
  voidedByUserId    String?
  voidReason        String?

  company         Company                             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  movement        BankMovement                        @relation(fields: [bankMovementId], references: [id], onDelete: Restrict)
  allocations     BankReconciliationAllocation[]
  paymentEvidence BankReconciliationPaymentEvidence[]

  @@index([bankMovementId, status, confirmedAt])
  @@index([companyId, confirmedAt])
}

model BankReconciliationAllocation {
  id               String @id @default(cuid())
  reconciliationId String
  entryLineId      String
  amountCents      BigInt

  reconciliation BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  entryLine      EntryLine          @relation(fields: [entryLineId], references: [id], onDelete: Restrict)

  @@unique([reconciliationId, entryLineId])
  @@index([entryLineId])
}

model BankReconciliationPaymentEvidence {
  id               String @id @default(cuid())
  reconciliationId String
  paymentId        String
  amountCents      BigInt

  reconciliation BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  payment        Payment            @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([reconciliationId, paymentId])
  @@index([paymentId])
}

model TaxPeriod {
  id                 String   @id @default(cuid())
  companyId          String
  label              String
  collectedVatCents  BigInt
  deductibleVatCents BigInt
  dueVatCents        BigInt
  creditVatCents     BigInt
  status             String
  declarationDue     DateTime
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Employee {
  id                String           @id @default(cuid())
  companyId         String
  fullName          String
  cin               String
  cnss              String
  position          String
  grossSalaryCents  BigInt
  cnssEmployeeCents BigInt
  amoEmployeeCents  BigInt
  irCents           BigInt
  netSalaryCents    BigInt
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollSnapshots  PayrollRunLine[]
}

model PayrollRun {
  id            String           @id @default(cuid())
  companyId     String
  period        String
  status        String           @default("DRAFT")
  postedEntryId String?          @unique
  voidEntryId   String?          @unique
  createdAt     DateTime         @default(now())
  postedAt      DateTime?
  voidedAt      DateTime?
  voidReason    String?
  version       Int              @default(1)
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
