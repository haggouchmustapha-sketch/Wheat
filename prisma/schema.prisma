/// Immutable invoice render. Services only append revisions; they never update
/// or delete an artifact that has been handed to the user or audit workflow.
model InvoiceArtifact {
  id                   String           @id @default(cuid())
  companyId            String
  invoiceId            String
  kind                 String           @default("IMMUTABLE_PDF")
  revision             Int              @default(1)
  supersedesArtifactId String?          @unique
  pdfBytes             Bytes
  storedPath           String?
  mimeType             String           @default("application/pdf")
  byteSize             BigInt
  contentSha256        String
  payloadJson          String
  payloadSha256        String
  createdByUserId      String?
  createdAt            DateTime         @default(now())
  immutable            Boolean          @default(true)
  company              Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoice              Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy            User?            @relation("InvoiceArtifactActor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  supersedesArtifact   InvoiceArtifact? @relation("InvoiceArtifactRevisions", fields: [supersedesArtifactId], references: [id], onDelete: Restrict)
  supersedingArtifact  InvoiceArtifact? @relation("InvoiceArtifactRevisions")

  @@unique([invoiceId, kind, revision])
  @@index([companyId, createdAt])
  @@index([contentSha256])
  @@index([payloadSha256])
}

