/// A workpaper is a reproducible VAT evidence snapshot. A correction creates a
/// successor revision; a filed workpaper is not edited in place.
model VatWorkpaper {
  id                        String                   @id @default(cuid())
  companyId                 String
  taxConfigurationVersionId String
  lineageKey                String
  revision                  Int                      @default(1)
  supersedesWorkpaperId     String?                  @unique
  periodStart               DateTime
  periodEnd                 DateTime
  status                    String                   @default("DRAFT")
  basisSnapshot             String
  frequencySnapshot         String
  sourceSha256              String
  evidenceSha256            String?
  collectedVatCents         BigInt                   @default(0)
  deductibleVatCents        BigInt                   @default(0)
  adjustmentVatCents        BigInt                   @default(0)
  netVatDueCents            BigInt                   @default(0)
  creditCarryforwardCents   BigInt                   @default(0)
  preparedAt                DateTime                 @default(now())
  reviewedAt                DateTime?
  reviewedByUserId          String?
  filedAt                   DateTime?
  filedByUserId             String?
  filingReference           String?
  filingReceiptDocumentId   String?
  version                   Int                      @default(1)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  company                   Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  taxConfigurationVersion   TaxConfigurationVersion  @relation(fields: [taxConfigurationVersionId], references: [id], onDelete: Restrict)
  supersedesWorkpaper       VatWorkpaper?            @relation("VatWorkpaperRevisions", fields: [supersedesWorkpaperId], references: [id], onDelete: Restrict)
  supersedingWorkpaper      VatWorkpaper?            @relation("VatWorkpaperRevisions")
  reviewedBy                User?                    @relation("VatWorkpaperReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  filedBy                   User?                    @relation("VatWorkpaperFiler", fields: [filedByUserId], references: [id], onDelete: SetNull)
  filingReceiptDocument     Document?                @relation("VatFilingReceipt", fields: [filingReceiptDocumentId], references: [id], onDelete: Restrict)
  lines                     VatWorkpaperLine[]
  adjustments               VatWorkpaperAdjustment[]
  evidence                  VatWorkpaperEvidence[]

  @@unique([companyId, lineageKey, revision])
  @@index([companyId, periodStart, periodEnd, status])
  @@index([taxConfigurationVersionId])
  @@index([reviewedByUserId, reviewedAt])
  @@index([filedByUserId, filedAt])
  @@index([filingReceiptDocumentId])
}

