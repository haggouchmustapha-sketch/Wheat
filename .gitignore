node_modules/

# =========================
# GENERATED PADDLEOCR SIDECAR
# =========================
# `npm run paddle:setup` copies a portable Python interpreter into runtime/ and
# warms the pinned OCR models into models/ — together ~2.1 GB of downloaded
# binaries that are reproducible from requirements.txt. resources/paddleocr's
# own README already declares both as ignored; this is where that is enforced.
# worker.py, xls_reader.py, requirements.txt and README.md ARE source and stay.
resources/paddleocr/runtime/
resources/paddleocr/models/

# =========================
# BUILD / RELEASE OUTPUT
# =========================
build/
dist/
dist-electron/
# A stray copy of the bundled main process sometimes lands at the repo root;
# the real entry point is dist-electron/main.js (see package.json "main").
/main.js
release/
release-verify/
out/
updates/*/
*.blockmap

